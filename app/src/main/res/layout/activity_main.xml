<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding= "16dp" >

    <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical" >

        <!-- Thong tin sinh vien va de bai -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Wo1A - Nguyen Nhuan Tri - 2415141122122"
            android:textAlignment="center"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- O ten hoc phan -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Ten hoc phan (1..40 ky tu):" />
        <EditText
            android:id="@+id/edtTen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nhap ten hoc phan"
            android:inputType="text" />

        <!-- O diem qua trinh -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Diem qua trinh QT (0.0 .. 10.0):" />

        <EditText
            android:id="@+id/edtQt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Vi du 7.5"
            android:inputType="numberDecimal" />

        <!-- O diem cuoi ki CK -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Diem cuoi ky CK (0.0 .. 10.0):" />

        <EditText
            android:id="@+id/edtCk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Vi du 6.0"
            android:inputType="numberDecimal" />

        <!-- Hai nut bam ngang hang -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnKiemTra"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="Kiem Tra" />
            <Button
                android:id="@+id/btnXoa"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Xoa" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
